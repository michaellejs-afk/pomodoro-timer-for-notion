<html lang="en"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Scholar's Playlist</title>
<style>
  :root{
    --ink:#e9dfc9;
    --muted:#b8aa90;
    --gold:#c4a66b;
    --gold-dark:#80683e;
    --paper:#1d1915;
    --paper2:#282119;
    --line:rgba(196,166,107,.34);
    --shadow:rgba(0,0,0,.55);
  }
  *{box-sizing:border-box}
  body{
    margin:0;
    min-height:100vh;
    background:
      radial-gradient(circle at 20% 10%, rgba(196,166,107,.08), transparent 28%),
      linear-gradient(135deg,#11100e 0%,#1d1915 45%,#151310 100%);
    color:var(--ink);
    font-family:Georgia,"Times New Roman",serif;
    padding:28px 18px;
  }
  .page{
    max-width:760px;
    margin:auto;
    position:relative;
    background:linear-gradient(145deg,var(--paper2),var(--paper));
    border:1px solid var(--line);
    border-radius:4px;
    padding:30px;
    box-shadow:0 20px 50px var(--shadow), inset 0 0 0 1px rgba(255,255,255,.025);
  }
  .page:before{
    content:"";
    position:absolute;
    inset:9px;
    border:1px solid rgba(196,166,107,.12);
    pointer-events:none;
  }
  .ornament{
    text-align:center;
    color:var(--gold);
    font-size:22px;
    letter-spacing:8px;
    margin-bottom:8px;
  }
  .eyebrow{
    text-align:center;
    text-transform:uppercase;
    letter-spacing:4px;
    color:var(--muted);
    font-size:11px;
  }
  h1{
    text-align:center;
    margin:7px 0 5px;
    font-size:34px;
    font-weight:500;
    letter-spacing:1px;
  }
  .subtitle{
    text-align:center;
    color:var(--muted);
    font-style:italic;
    margin:0 0 22px;
  }
  .rule{
    height:1px;
    background:linear-gradient(90deg,transparent,var(--gold-dark),transparent);
    margin:20px 0;
  }
  .label{
    text-transform:uppercase;
    letter-spacing:3px;
    font-size:10px;
    color:var(--gold);
    margin-bottom:9px;
  }
  .player{
    overflow:hidden;
    border:1px solid var(--line);
    border-radius:10px;
    background:#000;
    box-shadow:0 10px 25px rgba(0,0,0,.35);
  }
  iframe{
    display:block;
    width:100%;
    height:352px;
    border:0;
    border-radius:10px;
  }
  .ritual{
    margin-top:20px;
    padding:16px 18px;
    border-left:2px solid var(--gold-dark);
    background:rgba(0,0,0,.13);
    color:var(--muted);
    font-size:14px;
    line-height:1.65;
  }
  .ritual strong{color:var(--ink);font-weight:normal}
  .fallback{
    text-align:center;
    margin-top:18px;
  }
  .fallback a{
    display:inline-block;
    padding:10px 17px;
    border:1px solid var(--gold-dark);
    border-radius:3px;
    color:var(--ink);
    background:rgba(196,166,107,.08);
    text-decoration:none;
    font-size:13px;
    letter-spacing:.5px;
  }
  .fallback a:hover{background:rgba(196,166,107,.18)}
  .fallback small{
    display:block;
    margin-top:9px;
    color:#918570;
    font-size:11px;
  }
  footer{
    text-align:center;
    margin-top:22px;
    color:var(--gold-dark);
    font-size:12px;
    letter-spacing:4px;
  }
  @media(max-width:560px){
    body{padding:10px}
    .page{padding:22px 14px}
    h1{font-size:28px}
    iframe{height:352px}
  }
</style>
</head>
<body>
<main class="page">
  <div class="ornament">☙ ✦ ❧</div>
  <div class="eyebrow">The Scholar's Study</div>
  <h1>Study Atmosphere</h1>
  <p class="subtitle">A soundtrack for quiet work and long hours of study.</p>

  <div class="rule"></div>

  <div class="label">Now Playing</div>
  <div class="player">
    <iframe title="Spotify study playlist" src="https://open.spotify.com/embed/playlist/0IibkkHzHAoSVGWkUA39iF?utm_source=generator&amp;theme=0" width="100%" height="352" frameborder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy">
    </iframe>
  </div>

  <div class="ritual">
    <strong>☙ Before beginning</strong><br>
    Prepare your materials · Silence distractions · Choose one clear objective
    <br><br>
    <strong>❧ During the break</strong><br>
    Step away from the desk · Drink water · Rest your eyes · Return refreshed
  </div>

  <div class="fallback">
    <a href="https://open.spotify.com/playlist/0IibkkHzHAoSVGWkUA39iF" target="_blank" rel="noopener noreferrer">
      Open Playlist in Spotify ↗
    </a>
    <small>If the embedded player is blocked by Notion, use the button above.</small>
  </div>

  <footer>PER ASPERA AD ASTRA</footer>
</main>

</body></html>
